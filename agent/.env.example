# Copy this file to .env and fill in one credential option.

# --- A. Google AI Studio (recommended) ---
GEMINI_API_KEY=your-api-key-here

# --- B. Vertex AI (alternative) ---
# Uncomment these and remove GEMINI_API_KEY when using Vertex AI.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Local runtime configuration.
AGENT_MODEL=gemini-3.1-flash-lite
MCP_URL=http://localhost:8010/mcp
FRONTEND_URL=http://localhost:3000
ALLOW_ORIGINS=http://localhost:3000

# A2A: advertised on agent cards and used by the quotation -> order handoff.
# Docker: http://localhost:8080. Local uvicorn on 8099: http://localhost:8099.
A2A_BASE_URL=http://localhost:8080
