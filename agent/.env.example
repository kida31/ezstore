# Copy this file to .env and fill in one credential option.

# --- A. Google AI Studio (recommended) ---
GEMINI_API_KEY=your-api-key-here

# --- B. Vertex AI (alternative) ---
# Uncomment these and remove GEMINI_API_KEY when using Vertex AI.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Local runtime configuration.
# 預設為 gemini-3.8-flash；若遇到 503 high demand，可改成 gemini-3.5-flash。
AGENT_MODEL=gemini-3.8-flash
MCP_URL=http://localhost:8010/mcp
FRONTEND_URL=http://localhost:3000
ALLOW_ORIGINS=http://localhost:3000
